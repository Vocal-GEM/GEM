ount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"/app/src/components/ui/GenderPerceptionDashboard.jsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"/app/src/components/ui/GlobalErrorBoundary.jsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"/app/src/components/ui/GlowPulse.jsx","messages":[{"ruleId":"react-refresh/only-export-components","severity":1,"message":"Fast refresh only works when a file only exports components. Use a new file to share constants or functions between components.","line":54,"column":14,"nodeType":"Identifier","messageId":"namedExport","endLine":54,"endColumn":34},{"ruleId":"react-refresh/only-export-components","severity":1,"message":"Fast refresh only works when a file only exports components. Use a new file to share constants or functions between components.","line":58,"column":14,"nodeType":"Identifier","messageId":"namedExport","endLine":58,"endColumn":31},{"ruleId":"react-refresh/only-export-components","severity":1,"message":"Fast refresh only works when a file only exports components. Use a new file to share constants or functions between components.","line":92,"column":14,"nodeType":"Identifier","messageId":"namedExport","endLine":92,"endColumn":32}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState, useEffect } from 'react';\n\n/**\n * GlowPulse - Subtle celebration effect with pulsing glow\n * More elegant alternative to confetti\n */\nconst GlowPulse = ({ trigger, duration = 2000, color = 'teal' }) => {\n    const [isActive, setIsActive] = useState(false);\n\n    useEffect(() => {\n        if (trigger && !isActive) {\n            setIsActive(true);\n            setTimeout(() => setIsActive(false), duration);\n        }\n    }, [trigger, duration, isActive]);\n\n    const colorMap = {\n        teal: 'rgba(20, 184, 166, 0.4)',\n        purple: 'rgba(139, 92, 246, 0.4)',\n        pink: 'rgba(236, 72, 153, 0.4)',\n        blue: 'rgba(59, 130, 246, 0.4)',\n        amber: 'rgba(245, 158, 11, 0.4)',\n        emerald: 'rgba(16, 185, 129, 0.4)'\n    };\n\n    const glowColor = colorMap[color] || colorMap.teal;\n\n    if (!isActive) return null;\n\n    return (\n        <div className=\"fixed inset-0 pointer-events-none z-[100]\">\n            {/* Radial glow from center */}\n            <div\n                className=\"absolute inset-0 animate-pulse-glow-celebration\"\n                style={{\n                    background: `radial-gradient(circle at center, ${glowColor} 0%, transparent 70%)`\n                }}\n            />\n\n            {/* Edge glow effect */}\n            <div\n                className=\"absolute inset-0 animate-edge-glow\"\n                style={{\n                    boxShadow: `inset 0 0 100px 20px ${glowColor}`\n                }}\n            />\n        </div>\n    );\n};\n\n// Global trigger system\nlet globalGlowTrigger = null;\n\nexport const setGlobalGlowTrigger = (trigger) => {\n    globalGlowTrigger = trigger;\n};\n\nexport const triggerGlobalGlow = (color = 'teal') => {\n    if (globalGlowTrigger) {\n        globalGlowTrigger(color);\n    }\n};\n\n/**\n * GlowPulseProvider - Wrap your app to enable global glow celebrations\n */\nexport const GlowPulseProvider = ({ children }) => {\n    const [showGlow, setShowGlow] = useState(false);\n    const [color, setColor] = useState('teal');\n\n    useEffect(() => {\n        setGlobalGlowTrigger((newColor) => {\n            setColor(newColor || 'teal');\n            setShowGlow(true);\n            setTimeout(() => setShowGlow(false), 100);\n        });\n\n        return () => setGlobalGlowTrigger(null);\n    }, []);\n\n    return (\n        <>\n            <GlowPulse trigger={showGlow} color={color} />\n            {children}\n        </>\n    );\n};\n\n/**\n * Hook for using glow celebration\n */\nexport const useGlowCelebration = () => {\n    const celebrate = (color = 'teal') => {\n        triggerGlobalGlow(color);\n    };\n\n    return { celebrate };\n};\n\nexport default GlowPulse;\n","usedDeprecatedRules":[{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"/app/src/components/ui/GoalTrackerPanel.jsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"/app/src/components/ui/GraduationReflection.jsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"/app/src/components/ui/GuidedJourney.jsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]}]},{"filePath":"/app/src/components/ui/HabitBuilder.jsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"no-ex